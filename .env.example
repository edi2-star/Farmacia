# Puerto local (en Render, PORT lo inyecta la plataforma automáticamente)
PORT=4000

# Cadena de conexión de MongoDB (local o MongoDB Atlas en producción)
MONGODB_URI=

# Clave secreta para firmar los JWT (usa un valor largo y aleatorio)
JWT_SECRET=

# Vigencia del token
JWT_EXPIRES_IN=2h

# production en Render, development en local
NODE_ENV=development