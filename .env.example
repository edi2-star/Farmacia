# Puerto local (en Render, PORT lo inyecta la plataforma automáticamente)
PORT=4000

# Cadena de conexion de PostgreSQL.
# En Render: la variable DATABASE_URL la inyecta el servicio de PostgreSQL.
# En local: apunta a tu instancia, ej. postgresql://usuario:clave@127.0.0.1:5432/bd_Farmacia
DATABASE_URL=

# true para forzar SSL (Render externo lo requiere), false para conexiones internas/local
PGSSL=false

# Clave secreta para firmar los JWT (usa un valor largo y aleatorio)
JWT_SECRET=

# Vigencia del token
JWT_EXPIRES_IN=2h

# production en Render, development en local
NODE_ENV=development