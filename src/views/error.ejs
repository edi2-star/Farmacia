<%- include('./partials/head', { titulo: titulo }) %>
<%- include('./partials/navbar', { mostrarBuscador: false }) %>

<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 text-center">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
          <div class="display-4 text-danger mb-2"><i class="bi bi-exclamation-octagon"></i></div>
          <h1 class="h3 mb-2"><%= codigo %></h1>
          <p class="text-muted mb-4"><%= mensaje %></p>
          <a href="/menu" class="btn btn-primary me-2">
            <i class="bi bi-house-door me-1"></i> Volver al inicio
          </a>
          <a href="/login" class="btn btn-outline-secondary">
            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesion
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('./partials/footer') %>
